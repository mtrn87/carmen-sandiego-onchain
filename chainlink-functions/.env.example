# Chainlink Functions Relayer Server Configuration

# Sepolia RPC URL (get from Infura, Alchemy, or other provider)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# PlayerRegistry contract address on Sepolia
PLAYER_REGISTRY_ADDRESS=0x40cfae50af62D18480bb588b7554b07d6dFE13e7

# Private key of wallet that will pay gas for registrations
# This wallet must have ETH for gas fees
# NEVER commit this to git - use .env file instead
CHAINLINK_FUNCTIONS_PRIVATE_KEY=your_private_key_here

# Server port
PORT=3001
