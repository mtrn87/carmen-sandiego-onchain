# Game contract addresses (Ethereum Sepolia)
VITE_GAME_MASTER_ADDRESS=0xYOUR_GAME_MASTER_ADDRESS_HERE
VITE_GAME_MASTER_PROXY_ADDRESS=0xYOUR_GAME_MASTER_PROXY_ADDRESS_HERE
VITE_MISSION_NFT_ADDRESS=0xYOUR_MISSION_NFT_ADDRESS_HERE
VITE_PLAYER_REGISTRY_ADDRESS=0xYOUR_PLAYER_REGISTRY_ADDRESS_HERE

# ─── CityNode Addresses (real testnets, one per chain) ───
# Set after running: npm run deploy:citynode --network <name>

# Arbitrum Sepolia (chainId 421614) — Tokyo, Ottawa
VITE_CITYNODE_ARBITRUM_SEPOLIA_ADDRESS=0xYOUR_ARBITRUM_CITYNODE_ADDRESS_HERE
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Base Sepolia (chainId 84532) — Paris, Rome
VITE_CITYNODE_BASE_SEPOLIA_ADDRESS=0xYOUR_BASE_CITYNODE_ADDRESS_HERE
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# XDC Apothem (chainId 51) — Sydney, Nairobi, Rio de Janeiro
VITE_CITYNODE_XDC_APOTHEM_ADDRESS=0xYOUR_XDC_CITYNODE_ADDRESS_HERE
VITE_XDC_APOTHEM_RPC_URL=https://erpc.apothem.network

# ─── Coming Soon Chains (no CityNode yet, RPC for future use) ───
VITE_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
VITE_BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-e.bnbchain.org:8545
VITE_ETHEREUM_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ─── Hardhat Local Testing (chainId 31337) ───
# After running: npx hardhat node && npx hardhat run scripts/deploy-citynode.ts --network localhost
# Copy the VITE_HARDHAT_CITYNODE_* addresses printed by the deploy script.

VITE_HARDHAT_CITYNODE_421614_ADDRESS=0xYOUR_HARDHAT_TOKYO_HERE
VITE_HARDHAT_CITYNODE_97_ADDRESS=0xYOUR_HARDHAT_LONDON_HERE
VITE_HARDHAT_CITYNODE_84532_ADDRESS=0xYOUR_HARDHAT_PARIS_HERE
VITE_HARDHAT_CITYNODE_51_ADDRESS=0xYOUR_HARDHAT_SYDNEY_HERE
VITE_HARDHAT_CITYNODE_80002_ADDRESS=0xYOUR_HARDHAT_SANTIAGO_HERE
VITE_HARDHAT_CITYNODE_11155111_ADDRESS=0xYOUR_HARDHAT_NYC_HERE
VITE_HARDHAT_LOCAL_RPC_URL=http://localhost:8545

# Relayer server URL for gasless transactions
VITE_RELAYER_URL=http://localhost:3001

# Mock mode: when 'true', CityNode functions return mock data without calling real contracts.
VITE_MOCK_MODE=true
