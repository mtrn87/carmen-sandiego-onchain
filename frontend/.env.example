# GameMaster contract address on Sepolia (set after deploy)
VITE_GAME_MASTER_ADDRESS=0xYOUR_GAME_MASTER_ADDRESS_HERE

# MissionNFT contract address on Sepolia (set after deploy)
VITE_MISSION_NFT_ADDRESS=0xYOUR_MISSION_NFT_ADDRESS_HERE

# Optional (Dev Menu): CityNode contract addresses
VITE_CITYNODE_TOKYO_ADDRESS=0xYOUR_TOKYO_CITYNODE_ADDRESS_HERE
VITE_CITYNODE_PARIS_ADDRESS=0xYOUR_PARIS_CITYNODE_ADDRESS_HERE
VITE_CITYNODE_LONDON_ADDRESS=0xYOUR_LONDON_CITYNODE_ADDRESS_HERE

# CityNode RPC URLs (override defaults for cross-chain reads)
# For local hardhat testing, set all three to http://localhost:8545
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_XDC_APOTHEM_RPC_URL=https://erpc.apothem.network
